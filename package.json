{
  "name": "estudio-apce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {"node": ">=20.11"},
  "scripts": {
    "start": "node server.mjs",
    "init:windows": "python scripts/preparar.py",
